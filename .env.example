# ==========================================================================
# CyberAudit — variáveis de ambiente (Backend)
# Copie para .env e preencha. NUNCA commite o .env com valores reais.
# Cada variável abaixo é lida pelo application.properties (${NOME:default}).
# App sobe na porta 8081 (server.port fixo no application.properties).
# ==========================================================================

# ── Banco de dados (OBRIGATÓRIO) ───────────────────────────────────────────
# O docker-compose local lê DB_PASSWORD daqui — não há mais senha hardcoded nele.
# Sem default no application.properties: deploy sem DB_PASSWORD falha no boot,
# em vez de subir com uma senha de exemplo pública.
DB_URL=jdbc:postgresql://localhost:5434/cyberaudit
DB_USERNAME=cyberaudit
DB_PASSWORD=<gere-uma-senha-forte>

# ── JWT (OBRIGATÓRIO) ──────────────────────────────────────────────────────
# MÍNIMO 32 caracteres (256 bits). Menos que isso, o app NÃO sobe
# (io.jsonwebtoken WeakKeyException). Gere um aleatório, ex:
#   openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-de-32-caracteres-ou-mais

# ── Segredo do token de posse de domínio ───────────────────────────────────
# O token gravado em /.well-known/cyberaudit.txt é HMAC deste segredo.
# Vazio = cai no JWT_SECRET — o que significa que ROTACIONAR O JWT INVALIDA
# TODOS os tokens de posse já publicados pelos clientes. Se pretende rotacionar
# o JWT algum dia (deveria), defina um valor estável aqui ANTES do lançamento.
DOMAIN_VERIFICATION_SECRET=

# ── Equipe da plataforma ───────────────────────────────────────────────────
# E-mails (separados por vírgula) que dispensam a prova de posse de domínio no
# scan ativo. Role.OWNER NÃO serve: /auth/register é público e cria todo cadastro
# já como OWNER. Vazio = ninguém tem privilégio cross-tenant (padrão seguro).
PLATFORM_STAFF_EMAILS=

# ── Proxy reverso ──────────────────────────────────────────────────────────
# Atrás de nginx/Let's Encrypt, getRemoteAddr() devolve o IP do proxy e TODOS os
# visitantes caem no mesmo balde de rate-limit e no mesmo dono de scan async.
# Use "framework" quando houver proxy CONFIÁVEL na frente; "none" se o app está
# exposto direto (X-Forwarded-For é forjável).
FORWARD_HEADERS=none

# ── Capacidade do motor de scan ────────────────────────────────────────────
# Teto global de scans simultâneos (cada scan abre ~16 threads). Excedente entra
# em fila e, estourando o timeout, recebe 503.
SCAN_MAX_CONCURRENT=4
SCAN_ACQUIRE_TIMEOUT=20
# TTL do cache de DNS da JVM, em segundos — reduz a janela de DNS rebinding
# entre a validação do SsrfGuard e a conexão do HttpClient.
DNS_CACHE_TTL_SECONDS=30

# ── CORS — origens do frontend, separadas por vírgula ──────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── E-mail (notificações de scan, OTP 2FA, feedback) ───────────────────────
# MAIL_ENABLED=false desativa todo envio sem remover a config.
# Para Gmail use uma "Senha de app" (não a senha normal da conta).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@cyberaudit.app

# Caixa opcional que recebe cópia de TODO feedback de cliente (cross-tenant).
# Vazio = só notifica OWNER/ADMIN da conta do remetente.
FEEDBACK_NOTIFY_EMAIL=

# ── NVD (correlação de CVE) ────────────────────────────────────────────────
# Chave opcional: sobe o rate-limit de 5 → 50 req/30s (menos erros 429).
# Grátis: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── Mercado Pago / Billing (assinaturas) ───────────────────────────────────
# Token de TESTE (sandbox) ou produção — painel MP > Suas integrações > Credenciais.
# Vazio = pagamentos desativados (/billing/subscribe responde 503 claro).
MP_ACCESS_TOKEN=
# Secret p/ validar a assinatura x-signature do webhook (vazio = pula, sandbox).
MP_WEBHOOK_SECRET=
# Base pública do app (usada no back_url do checkout MP).
APP_BASE_URL=http://localhost:5173
# Preços das assinaturas (mensal). Ajuste livremente.
BILLING_CURRENCY=BRL
BILLING_PRO_AMOUNT=29.90
BILLING_ENTERPRISE_AMOUNT=99.90
